table ip6 filter {
	chain input{
		type filter hook input priority 0;
		policy drop;

		ct state established, related accept
		iif lo accept

		
		tcp dport 22 accept 
		
		tcp dport 80 accept 
		
		tcp dport 443 accept 
		

		
		ip6 saddr ::1/128 accept 
		
		ip6 saddr fd00::/8 accept 
		

		ip6 nexthdr icmpv6 accept
	}
}
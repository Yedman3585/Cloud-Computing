stages:
  - build
  - lint
  - test
  - report

# ---------------------------------------------------------------------------
# VARIABLES shared across all jobs
# ---------------------------------------------------------------------------
variables:
  # Docker image names (built in 'build' stage, used in 'test' stage)
  FW_IMAGE:     "firewall-node:${CI_COMMIT_SHORT_SHA}"
  CLIENT_IMAGE: "firewall-client:${CI_COMMIT_SHORT_SHA}"

  # Test result paths (written by pytest, read by report job)
  REPORT_DIR:   "${CI_PROJECT_DIR}/test_results"
  PYTEST_JSON:  "${CI_PROJECT_DIR}/test_results/pytest.json"
  HTML_REPORT:  "${CI_PROJECT_DIR}/test_results/report.html"

# ---------------------------------------------------------------------------
# STAGE 1: build
# Build both Docker images. If this fails, everything else is skipped.
# ---------------------------------------------------------------------------
build:firewall-image:
  stage: build
  image: docker:24
  services:
    - docker:24-dind          # Docker-in-Docker: lets us run docker build in CI
  variables:
    DOCKER_TLS_CERTDIR: "/certs"
  script:
    - echo "Building firewall node image..."
    - docker build
        --file docker/DockerFile
        --tag "${FW_IMAGE}"
        .
    - echo "Build complete — image ${FW_IMAGE}"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

build:client-image:
  stage: build
  image: docker:24
  services:
    - docker:24-dind
  variables:
    DOCKER_TLS_CERTDIR: "/certs"
  script:
    - echo "Building client/test-runner image..."
    - docker build
        --file docker/Dockerfile.client
        --tag "${CLIENT_IMAGE}"
        .
    - echo "Build complete — image ${CLIENT_IMAGE}"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

# ---------------------------------------------------------------------------
# STAGE 2: lint
# Fast checks that don't require running containers.
# These catch obvious mistakes before wasting time on the test stage.
# ---------------------------------------------------------------------------
lint:nftables-syntax:
  stage: lint
  image: debian:trixie-slim
  before_script:
    - apt-get update -qq && apt-get install -y -qq nftables python3 python3-pip
    - pip3 install --break-system-packages jinja2 pyyaml
  script:
    - echo "Checking nftables rule syntax..."
    # Generate the nftables rules from templates using render.py
    - python3 render.py
    # -c = check mode (dry run — validates syntax without applying rules)
    - nft -c -f generated_ipv4.nft && echo "IPv4 rules: OK"
    - nft -c -f generated_ipv6.nft && echo "IPv6 rules: OK"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

lint:python-style:
  stage: lint
  image: python:3.11-slim
  before_script:
    - pip install --quiet pyflakes
  script:
    - echo "Checking Python files for syntax errors..."
    # pyflakes catches undefined variables, unused imports, syntax errors
    - python3 -m pyflakes tests/conftest.py
    - python3 -m pyflakes tests/test_nftables_rules.py
    - python3 -m pyflakes tests/test_failover.py
    - python3 -m pyflakes tests/test_ipv6.py
    - python3 -m pyflakes tests/test_conntrackd.py
    - python3 -m pyflakes tests/traffic_generator.py
    - python3 -m pyflakes scripts/monitor_health.py
    - python3 -m pyflakes scripts/generate_report.py
    - echo "All Python files: OK"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

lint:docker-compose-valid:
  stage: lint
  image: docker:24
  services:
    - docker:24-dind
  variables:
    DOCKER_TLS_CERTDIR: "/certs"
  script:
    - echo "Validating docker-compose.yml..."
    # 'config' command validates the compose file and prints the merged config
    - docker compose config --quiet && echo "docker-compose.yml: OK"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

# ---------------------------------------------------------------------------
# STAGE 3: test
# Spins up the full Docker Compose stack and runs the pytest suite.
# This is the main test job — it tests everything end-to-end.
# ---------------------------------------------------------------------------
test:integration:
  stage: test
  image: docker:24
  services:
    - docker:24-dind
  variables:
    DOCKER_TLS_CERTDIR: "/certs"
    # Environment variables passed to pytest (match docker-compose.yml IPs)
    FW1_MGMT_IP:     "172.20.0.11"
    FW2_MGMT_IP:     "172.20.0.12"
    FW3_MGMT_IP:     "172.20.0.13"
    FW1_FRONTEND_IP: "172.21.0.11"
    FW2_FRONTEND_IP: "172.21.0.12"
    FW3_FRONTEND_IP: "172.21.0.13"
    VIRTUAL_IP:      "172.20.0.100"
    SERVER1_IP:      "172.22.0.31"
    SERVER2_IP:      "172.22.0.32"
  before_script:
    # Install Python + test tools in the CI runner container
    - apk add --no-cache python3 py3-pip
    - pip3 install --break-system-packages pytest pytest-html pytest-json-report requests
    - mkdir -p "${REPORT_DIR}"
  script:
    # 1. Start the stack (fw nodes + clients + backend servers)
    - echo "Starting Docker Compose stack..."
    - docker compose up -d --build fw1 fw2 fw3 server1 server2 client1 client2 client3

    # 2. Wait for all fw nodes to be healthy (up to 90s)
    - echo "Waiting for containers to be healthy..."
    - |
      for container in fw1 fw2 fw3; do
        timeout=90
        elapsed=0
        while [ $elapsed -lt $timeout ]; do
          status=$(docker inspect --format '{{.State.Health.Status}}' $container 2>/dev/null)
          [ "$status" = "healthy" ] && break
          sleep 5
          elapsed=$((elapsed + 5))
        done
        [ "$status" = "healthy" ] || (echo "ERROR: $container not healthy after ${timeout}s" && exit 1)
        echo "$container: healthy"
      done

    # 3. Wait for Keepalived MASTER election (fw1 must hold VIP)
    - echo "Waiting 15s for Keepalived election..."
    - sleep 15

    # 4. Run nftables rule tests (fast, no container restarts)
    - echo "Running nftables rule tests..."
    - pytest tests/test_nftables_rules.py
        --json-report --json-report-file="${REPORT_DIR}/rules.json"
        -v --tb=short
      || true

    # 5. Run IPv6 tests
    - echo "Running IPv6 tests..."
    - pytest tests/test_ipv6.py
        --json-report --json-report-file="${REPORT_DIR}/ipv6.json"
        -v --tb=short
      || true

    # 6. Run conntrackd sync tests
    - echo "Running conntrackd tests..."
    - pytest tests/test_conntrackd.py
        --json-report --json-report-file="${REPORT_DIR}/conntrackd.json"
        -v --tb=short
      || true

    # 7. Run failover tests last (they stop/start containers)
    - echo "Running failover tests..."
    - pytest tests/test_failover.py
        --json-report --json-report-file="${PYTEST_JSON}"
        --html="${HTML_REPORT}" --self-contained-html
        -v --tb=short

  after_script:
    # Always collect logs, even if tests failed
    - docker compose logs fw1 > "${REPORT_DIR}/fw1.log" 2>&1 || true
    - docker compose logs fw2 > "${REPORT_DIR}/fw2.log" 2>&1 || true
    - docker compose logs fw3 > "${REPORT_DIR}/fw3.log" 2>&1 || true
    - docker compose down -v || true

  # Save test results as CI artifacts — downloadable from the Gitea UI
  artifacts:
    when: always            # save artifacts even if the job fails
    expire_in: 7 days
    paths:
      - test_results/
    reports:
      junit: test_results/pytest.json   # Gitea parses this for test result badges

  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

# ---------------------------------------------------------------------------
# STAGE 4: report
# Generate and publish the final HTML report.
# Runs even if the test stage had failures (when: always).
# ---------------------------------------------------------------------------
report:generate:
  stage: report
  image: python:3.11-slim
  before_script:
    - pip install --quiet pytest-json-report
  script:
    - echo "Generating HTML report..."
    - python3 scripts/generate_report.py
        --pytest-json "${PYTEST_JSON}"
        --health-json "${REPORT_DIR}/health.json"
        --output "${HTML_REPORT}"
    - echo "Report generated: ${HTML_REPORT}"
  artifacts:
    when: always
    expire_in: 30 days
    paths:
      - test_results/report.html
      - test_results/summary.json
  # Only run if the test job ran (even if it failed)
  needs:
    - job: test:integration
      artifacts: true
  when: always
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

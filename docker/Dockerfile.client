FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    iputils-ping \
    curl \
    wget \
    net-tools \
    iproute2 \
    tcpdump \
    netcat-openbsd \
    openssh-client \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages \
    scapy \
    requests \
    pytest \
    pytest-html

WORKDIR /tests

CMD ["tail", "-f", "/dev/null"]

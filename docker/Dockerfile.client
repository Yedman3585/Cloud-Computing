FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    iputils-ping \
    curl \
    wget \
    net-tools \
    iproute2 \
    tcpdump \
    netcat-openbsd \
    openssh-client \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages \
    scapy \
    requests \
    pytest \
    pytest-html \
    pytest-json-report

COPY docker/entrypoint-client.sh /entrypoint-client.sh
RUN sed -i 's/\r$//' /entrypoint-client.sh \
    && chmod +x /entrypoint-client.sh

WORKDIR /tests

ENTRYPOINT ["/entrypoint-client.sh"]
CMD ["tail", "-f", "/dev/null"]
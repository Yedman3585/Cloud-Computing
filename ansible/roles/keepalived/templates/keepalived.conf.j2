global_defs {
    router_id {{ inventory_hostname }}
}

{% for instance in keepalived_vrrp_instances %}
vrrp_instance {{ instance.instance_name }} {
    state {{ keepalived_state }}
    interface {{ instance.interface }}
    virtual_router_id {{ instance.virtual_router_id }}
    priority {{ keepalived_priority }}
    advert_int {{ keepalived_cluster.advert_int | default(1) }}

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_cluster.auth_pass }}
    }

    virtual_ipaddress {
        {{ instance.vip_ipv4 }}
{% if keepalived_cluster.enable_ipv6_vip | default(false) %}
        {{ instance.vip_ipv6 }}
{% endif %}
    }
}

{% endfor %}
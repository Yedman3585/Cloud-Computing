#!/usr/sbin/nft -f
{% macro render_rule_for_family(rule, family, suffix) -%}
{% set source = rule.source | default('any') %}
{% set destination = rule.destination | default('any') %}
{% set protocol = rule.protocol | default('all') %}
{% set action = rule.action | default('drop') %}
{% set source_values = [] if source == 'any' else firewall_objects[source][suffix] | default([]) %}
{% set destination_values = [] if destination == 'any' else firewall_objects[destination][suffix] | default([]) %}
{% set family_needed = source != 'any' or destination != 'any' or protocol in ['icmp', 'icmpv6', 'vrrp'] %}
{% set family_allowed = (family_needed or family == 'ip') and not (protocol == 'icmp' and family == 'ip6') and not (protocol == 'icmpv6' and family == 'ip') %}
{% if family_allowed and (source == 'any' or source_values | length > 0) and (destination == 'any' or destination_values | length > 0) %}
        # {{ rule.name }} ({{ family }})
{% if source != 'any' %}        {{ family }} saddr @{{ source }}_{{ suffix }}{% else %}        {% endif %}{% if destination != 'any' %} {{ family }} daddr @{{ destination }}_{{ suffix }}{% endif %}{% if protocol in ['tcp', 'udp'] %} {{ protocol }} dport { {{ rule.ports | join(', ') }} }{% elif protocol == 'icmp' %} ip protocol icmp{% elif protocol == 'icmpv6' %} ip6 nexthdr icmpv6{% elif protocol == 'vrrp' and family == 'ip' %} ip protocol vrrp{% elif protocol == 'vrrp' and family == 'ip6' %} ip6 nexthdr vrrp{% endif %} counter {{ action }}
{% endif %}
{%- endmacro %}
{% macro render_firewall_rule(rule) -%}
{{ render_rule_for_family(rule, 'ip', 'ipv4') }}
{{ render_rule_for_family(rule, 'ip6', 'ipv6') }}
{%- endmacro %}

flush ruleset

table inet filter {
{% for object_name, object_data in firewall_objects.items() %}
{% if object_data.ipv4 | default([]) | length > 0 %}
    set {{ object_name }}_ipv4 {
        type ipv4_addr
        flags interval
        elements = { {{ object_data.ipv4 | join(', ') }} }
    }

{% endif %}
{% if object_data.ipv6 | default([]) | length > 0 %}
    set {{ object_name }}_ipv6 {
        type ipv6_addr
        flags interval
        elements = { {{ object_data.ipv6 | join(', ') }} }
    }

{% endif %}
{% endfor %}
    chain input {
        type filter hook input priority 0;
        policy {{ firewall_default_policy }};

        ct state established,related accept
        iif lo accept

{% for rule in firewall_rules if rule.chain | default('input') == 'input' %}
{{ render_firewall_rule(rule) }}
{% endfor %}
    }

    chain forward {
        type filter hook forward priority 0;
        policy {{ firewall_default_policy }};

        ct state established,related accept

{% for rule in firewall_rules if rule.chain | default('input') == 'forward' %}
{{ render_firewall_rule(rule) }}
{% endfor %}
    }

    chain output {
        type filter hook output priority 0;
        policy accept;
    }
}

#!/usr/sbin/nft -f
{% macro family_rule(rule, family, suffix) -%}
{% set source = rule.source | default('any') %}
{% set destination = rule.destination | default('any') %}
{% set protocol = rule.protocol | default('all') %}
{% set action = rule.action | default('drop') %}
{% set source_values = [] if source == 'any' else firewall_objects[source][suffix] | default([]) %}
{% set destination_values = [] if destination == 'any' else firewall_objects[destination][suffix] | default([]) %}
{% set has_source = source == 'any' or source_values | length > 0 %}
{% set has_destination = destination == 'any' or destination_values | length > 0 %}
{% set protocol_allowed = not (protocol == 'icmp' and family == 'ip6') and not (protocol == 'icmpv6' and family == 'ip') %}
{% if has_source and has_destination and protocol_allowed %}
        # {{ rule.name }} ({{ family }})
        {% if source != 'any' %}{{ family }} saddr @{{ source }}_{{ suffix }} {% endif %}{% if destination != 'any' %}{{ family }} daddr @{{ destination }}_{{ suffix }} {% endif %}{% if protocol in ['tcp', 'udp'] %}{{ protocol }} dport { {{ rule.ports | join(', ') }} } {% elif protocol == 'icmp' %}ip protocol icmp {% elif protocol == 'icmpv6' %}ip6 nexthdr icmpv6 {% elif protocol == 'vrrp' %}meta l4proto 112 {% endif %}counter {{ action }}
{% endif %}
{%- endmacro %}
{% macro render_rule(rule) -%}
{{ family_rule(rule, 'ip', 'ipv4') }}
{{ family_rule(rule, 'ip6', 'ipv6') }}
{%- endmacro %}

flush ruleset

table inet filter {
    set ssh_bruteforce {
        type ipv4_addr
        flags dynamic,timeout
        timeout 5m
    }

{% for object_name, object_data in firewall_objects.items() %}
{% if object_data.ipv4 | default([]) | length > 0 %}
    set {{ object_name }}_ipv4 {
        type ipv4_addr
        flags interval
        elements = { {{ object_data.ipv4 | join(', ') }} }
    }

{% endif %}
{% if object_data.ipv6 | default([]) | length > 0 %}
    set {{ object_name }}_ipv6 {
        type ipv6_addr
        flags interval
        elements = { {{ object_data.ipv6 | join(', ') }} }
    }

{% endif %}
{% endfor %}
    chain input {
        type filter hook input priority 0;
        policy {{ firewall_default_policy }};

        ct state established,related accept
        iif lo accept

        # Dynamic SSH brute-force protection: track new connection attempts
        # per source IP; block sources making 4+ attempts within 60 seconds.
        tcp dport 22 ct state new add @ssh_bruteforce { ip saddr limit rate over 4/minute } drop

{% for rule in firewall_rules if rule.chain | default('input') == 'input' %}
{{ render_rule(rule) }}
{% endfor %}
{% if firewall_drop_logging_enabled | default(false) %}
        log prefix "{{ firewall_input_drop_log_prefix | default('DROP-IN ') }}" group {{ firewall_nflog_group | default(1) }} counter drop
{% endif %}
    }

    chain forward {
        type filter hook forward priority 0;
        policy {{ firewall_default_policy }};

        ct state established,related accept

{% for rule in firewall_rules if rule.chain | default('input') == 'forward' %}
{{ render_rule(rule) }}
{% endfor %}
{% if firewall_drop_logging_enabled | default(false) %}
        log prefix "{{ firewall_forward_drop_log_prefix | default('DROP-FWD ') }}" group {{ firewall_nflog_group | default(1) }} counter drop
{% endif %}
    }

    chain output {
        type filter hook output priority 0;
        policy accept;
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority 100;
        ip saddr 172.22.0.0/24 oif "eth0" masquerade
    }
}